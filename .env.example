PORT=3000
HOST=0.0.0.0
# Compatibilidad retro: clave única con permisos SUPER_ADMIN (x-api-key o Authorization: Bearer)
ADMIN_API_KEY=cambia-esta-clave
# Bootstrap opcional: crea un usuario SUPER_ADMIN real la primera vez que arranca (si no hay usuarios aún)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-password
DATA_FILE=./data/uniserver.json
HEALTH_INTERVAL_MS=30000
SESSION_TTL_MS=43200000
AGENT_OFFLINE_MS=90000
